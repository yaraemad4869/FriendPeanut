BEGIN;
SET search_path TO friend_peanut, public;
INSERT INTO units(code,name_ar,dimension) VALUES ('KG','كيلوجرام','MASS'),('TON','طن','MASS');
INSERT INTO factories(code,name_ar) VALUES ('F1_SORTING','مصنع مفروز'),('F2_PEELING','مصنع مفروك');
INSERT INTO warehouses(code,name_ar,factory_id) VALUES ('WH_AGRI','العوينات',NULL),('WH_SORTED','مصنع مفروز',(SELECT id FROM factories WHERE code='F1_SORTING')),('WH_PEELED','مصنع مفروك',(SELECT id FROM factories WHERE code='F2_PEELING')),('WH_PACKAGING','مواد التعبئة',NULL);
INSERT INTO app_users(slot_no,username,display_name) SELECT n,'U'||lpad(n::text,2,'0'),'حساب غير مهيأ '||n FROM generate_series(1,15) n;
INSERT INTO roles(code,name_ar) VALUES ('ADMIN','أدمن'),('MAIN_VIEWER','مستخدم رئيسي'),('ACCOUNTANT','محاسب'),('AGRICULTURE','مسؤول زراعة'),('WAREHOUSE','مسؤول مخزن'),('FACTORY_OPERATOR','مشغل مصنع');
INSERT INTO user_roles(user_id,role_id) SELECT u.id,r.id FROM app_users u JOIN roles r ON r.code=CASE WHEN slot_no<=3 THEN 'MAIN_VIEWER' WHEN slot_no<=7 THEN 'ACCOUNTANT' WHEN slot_no<=11 THEN 'AGRICULTURE' ELSE 'WAREHOUSE' END;
-- No password, active admin, broad grants, remote users, operating balances or accounting chart are invented here.
